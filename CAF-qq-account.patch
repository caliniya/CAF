+func TestQQRejectsOtherAccountBeforeLoginOrCredentialSave(t *testing.T) {
+	for _, fast := range []bool{false, true} {
+		s := &testQQSession{fast: fast}
+		e, dir, _ := sdkCore(t, s)
+		setQQAccountTest(t, dir, uint32(654321))
+		if _, err := e.BeginLogin(); err != nil {
