diff --git a/backend/desktop/QQDiagnostic.go b/backend/desktop/QQDiagnostic.go
new file mode 100644
index 0000000..69f4ee7
--- /dev/null
+++ b/backend/desktop/QQDiagnostic.go
@@ -0,0 +1,65 @@
+package desktop
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"regexp"
+	"syscall"
+)
+
+// qqDiagnosticError 只保存可以显示的错误码和中文说明，不保存 URL、响应正文或认证数据。
+type qqDiagnosticError struct {
+	code    string
+	message string
+}
+
+func (e *qqDiagnosticError) Error() string { return "[" + e.code + "] " + e.message }
+
+func qqDiagnostic(code, message string) error {
+	return &qqDiagnosticError{code: code, message: message}
+}
+
+var qrReturnCode = regexp.MustCompile(`^err qr retcode ([0-9]{1,3})$`)
+
+// describeQQError 使用白名单生成诊断，不把任意 SDK error.Error() 拼到页面或日志。
+func describeQQError(err error) (string, string) {
+	var diagnostic *qqDiagnosticError
+	if errors.As(err, &diagnostic) {
+		return diagnostic.code, diagnostic.message
+	}
+	var dns *net.DNSError
+	var network net.Error
+	switch {
+	case errors.Is(err, context.Canceled):
+		return "CANCELED", "操作已取消"
+	case errors.Is(err, context.DeadlineExceeded), errors.As(err, &network) && network.Timeout():
+		return "NETWORK_TIMEOUT", "网络请求超时；检查当前网络和服务是否可达"
+	case errors.As(err, &dns):
+		return "NETWORK_DNS", "域名解析失败；检查 DNS 和当前网络"
+	case errors.Is(err, syscall.ECONNREFUSED):
+		return "NETWORK_REFUSED", "连接被拒绝；检查服务进程、监听地址与端口"
+	case errors.Is(err, syscall.ENETUNREACH), errors.Is(err, syscall.EHOSTUNREACH):
+		return "NETWORK_UNREACHABLE", "网络或目标主机不可达；检查路由和防火墙"
+	case errors.Is(err, io.EOF), errors.Is(err, io.ErrUnexpectedEOF), errors.Is(err, net.ErrClosed), errors.Is(err, syscall.ECONNRESET):
+		return "NETWORK_CLOSED", "连接已关闭或返回数据不完整"
+	case errors.Is(err, os.ErrPermission):
+		return "FILE_PERMISSION", "无法读写本机文件；检查数据目录权限"
+	}
+	// 以下字符串是固定版本 SDK 的固定错误，不能泛化为输出底层原始文本。
+	if err != nil {
+		switch err.Error() {
+		case "Packet timed out":
+			return "QQ_PACKET_TIMEOUT", "等待 QQ 服务器响应超时；这不等同于签名服务器超时"
+		case "All servers are unreachable":
+			return "QQ_SERVER_UNREACHABLE", "QQ 服务器不可达；检查 TCP 网络与防火墙"
+		}
+		if match := qrReturnCode.FindStringSubmatch(err.Error()); match != nil {
+			return "QQ_QR_REJECTED_" + match[1], fmt.Sprintf("QQ 服务器拒绝二维码请求（返回码 %s）；核对协议版本及签名服务兼容性", match[1])
+		}
+	}
+	return "QQ_UNKNOWN", "底层原因暂未分类；请提供此失败阶段和错误码，不要公开配置、票据或原始报文"
+}
diff --git a/backend/desktop/QQSigner.go b/backend/desktop/QQSigner.go
new file mode 100644
index 0000000..d9e18b7
--- /dev/null
+++ b/backend/desktop/QQSigner.go
@@ -0,0 +1,68 @@
+package desktop
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"regexp"
+
+	"github.com/LagrangeDev/LagrangeGo/client/auth"
+	"github.com/LagrangeDev/LagrangeGo/client/sign"
+)
+
+type checkedQQSigner struct{ provider sign.Provider }
+
+// NewQQSigner 包装 SDK 的签名 Provider；构造不联网，也不执行试签名。
+// 只在真正需要签名的请求中检查响应，不能把 HTTP 200 当作签名成功。
+func NewQQSigner(cfg QQConfig) sign.Provider {
+	return &checkedQQSigner{provider: sign.NewSigner(nil, cfg.SignToken, cfg.SignServer)}
+}
+
+func (s *checkedQQSigner) AddRequestHeader(header map[string]string) {
+	s.provider.AddRequestHeader(header)
+}
+func (s *checkedQQSigner) SetAppInfo(app *auth.AppInfo) { s.provider.SetAppInfo(app) }
+func (s *checkedQQSigner) Release()                     { s.provider.Release() }
+
+var signHTTPStatus = regexp.MustCompile(`^unexpected status code: ([1-5][0-9]{2})$`)
+
+func (s *checkedQQSigner) Sign(command string, seq uint32, body []byte, uin uint32, guid, qua string) (*sign.Response, error) {
+	response, err := s.provider.Sign(command, seq, body, uin, guid, qua)
+	if err != nil {
+		if match := signHTTPStatus.FindStringSubmatch(err.Error()); match != nil {
+			hint := "核对服务状态与完整接口地址"
+			switch match[1] {
+			case "401", "403":
+				hint = "认证或权限失败；在本机检查 signToken 和服务授权"
+			case "404", "405":
+				hint = "接口路径或 POST 方法不匹配；不要只填写服务首页"
+			case "429":
+				hint = "请求受到限流；稍后手动重试"
+			}
+			return nil, qqDiagnostic("SIGN_HTTP_"+match[1], "签名服务返回 HTTP "+match[1]+"；"+hint)
+		}
+		var syntax *json.SyntaxError
+		var field *json.UnmarshalTypeError
+		var invalidHex hex.InvalidByteError
+		if errors.As(err, &syntax) || errors.As(err, &field) || errors.As(err, &invalidHex) || errors.Is(err, hex.ErrLength) {
+			return nil, qqDiagnostic("SIGN_RESPONSE_FORMAT", "签名响应不是预期的 JSON/十六进制格式；核对接口而不是服务首页")
+		}
+		code, detail := describeQQError(err)
+		return nil, qqDiagnostic("SIGN_"+code, "签名请求失败："+detail)
+	}
+	if !sign.ContainSignPKG(command) {
+		return response, nil
+	}
+	if response == nil {
+		return nil, qqDiagnostic("SIGN_EMPTY_RESPONSE", "签名服务没有返回签名结果")
+	}
+	if response.Code != 0 {
+		// 服务端 message 可能包含请求数据或认证链接，只保留数值 code。
+		return nil, qqDiagnostic(fmt.Sprintf("SIGN_REJECTED_%d", response.Code), "签名服务拒绝了请求；核对接口、令牌权限与协议版本")
+	}
+	if len(response.Value.SecSign) == 0 {
+		return nil, qqDiagnostic("SIGN_EMPTY_SIGNATURE", "签名响应缺少 value.sec_sign；HTTP 200 不代表协议兼容或签名成功")
+	}
+	return response, nil
+}
