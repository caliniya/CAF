{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CAF: Ensure wails CLI",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$w = Join-Path $env:USERPROFILE 'go\\bin\\wails.exe'; if (-not (Test-Path $w)) { $v = (Select-String -Path go.mod -Pattern 'github.com/wailsapp/wails/v2 (v[0-9.]+)').Matches[0].Groups[1].Value; Write-Host \"wails CLI not found, installing $v ...\"; go install \"github.com/wailsapp/wails/v2/cmd/wails@$v\"; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } } else { Write-Host \"wails CLI found: $w\" }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CAF: Build debug (Windows x64)",
      "type": "process",
      "command": "${env:USERPROFILE}\\go\\bin\\wails.exe",
      "args": [
        "build",
        "-debug",
        "-platform",
        "windows/amd64",
        "-o",
        "CAF-debug.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CGO_ENABLED": "0",
          "CAF_DATA_DIR": "${workspaceFolder}/build/dev-data"
        }
      },
      "dependsOn": "CAF: Ensure wails CLI",
      "problemMatcher": "$go",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CAF: Wails dev",
      "type": "process",
      "command": "pwsh",
      "windows": {
        "command": "powershell.exe"
      },
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "${workspaceFolder}/dev.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
